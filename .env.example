# ==============================================================================
# NutriVision AI: Master Environment Variables Template
# Copy relevant portions to frontend/.env.local and backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATIONS (frontend/.env.local)
# ------------------------------------------------------------------------------
# Supabase Project Connection Details
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# FastAPI Backend Service URL
NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# BACKEND CONFIGURATIONS (backend/.env)
# ------------------------------------------------------------------------------
# System Execution Mode
ENVIRONMENT=development
PORT=8000

# JWT secret key for signature verification (from Supabase settings)
JWT_SECRET=your-supabase-jwt-secret-for-jwt-verification-here

# Supabase Admin Sync configuration (used for direct service-role calls)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Object Storage Bucket Name for Scans
SUPABASE_STORAGE_BUCKET=food-scan-images

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS CONFIGURATIONS (backend/.env)
# ------------------------------------------------------------------------------
# USDA FoodData Central API Key
USDA_API_KEY=your-usda-fooddata-central-api-key-here

# Gemini AI Assistant API Key
GEMINI_API_KEY=your-gemini-api-key-here
